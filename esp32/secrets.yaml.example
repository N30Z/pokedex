# Copy this file to esp32/secrets.yaml and fill in your values.
# esp32/secrets.yaml is gitignored — never commit real credentials.

wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# LAN address of the running pokedex backend (docker compose up -d pokedex),
# no trailing slash. This is a self-hosted/offline project — use your local
# network address, not a public URL.
pokedex_voice__backend_base_url: "http://192.168.1.50:1510"
